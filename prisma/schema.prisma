generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// A conservancy is the accountable partner org that receives the conservation
// cut for the animals it protects. One conservancy can back many animals.
// A Conservancy is really "any cause a campaign's donations go to" — the
// name predates campaigns that don't depict a specific animal at all (see
// Campaign.conservancyId). Kept as-is rather than renamed throughout the
// codebase (a mass rename across every route/page referencing it is a lot
// of blast radius for a cosmetic change); admin-facing copy calls it
// "Cause" where that reads better. animals is populated only for
// wildlife-specific causes; campaigns is populated for both — a campaign
// either goes through an Animal (and this is derived) or links here
// directly (see Campaign.conservancyId).
model Conservancy {
  id            String   @id @default(cuid())
  name          String
  region        String
  mission       String
  website       String
  contactEmail  String
  payoutAccount String? // free-text note; superseded by the structured payout fields below
  animals       Animal[]
  campaigns     Campaign[]
  createdAt     DateTime @default(now())

  // Not real KYC/KYB — no identity or sanctions database is checked here,
  // this is a lightweight anti-impersonation checkpoint, not a compliance
  // program (get a lawyer involved before treating it as one). Anyone can
  // self-register a cause (see /cause/onboarding) with nothing but a name
  // and a self-asserted mission; these fields give an admin something
  // concrete to actually check instead of trusting prose, and a record of
  // what was checked. verifiedAt (the actual gate — /api/seller/campaigns
  // refuses to let an artist route a self-service campaign's donations to
  // an unverified cause) is only set by /api/admin/conservancies/[id]/verify
  // once all three checklist items below are confirmed together in one
  // request — see that route. Admin-created conservancies (via
  // /admin/conservancies) are verified at creation instead: an admin
  // entering one by hand already is the vetting.
  verifiedAt              DateTime?
  registrationNumber      String? // self-reported NGO/business registry number — the admin looks this up, it isn't validated automatically
  registrationDocumentUrl String? // an uploaded registration certificate/scan, for the admin to review
  payoutAccountHolderName String? // the name ON the payout account — should match `name` (money should go to the entity, not an individual); checked at verification, not enforced by the DB
  registrationCheckedAt   DateTime? // admin confirmed the registration number checks out
  // HOW it was confirmed — required, free text. Not every country has a
  // free instant registry lookup (Kenya's PBORA and Ethiopia's ACSO don't;
  // Nigeria's CAC and South Africa's NPO register do), so a uniform
  // checkbox would let "verified" mean anything from a one-click official
  // search to nothing at all. Forcing the admin to write down the actual
  // method (a paid records search, an independently-found phone call, a
  // sector-specific directory, whichever official registry) makes that
  // difference visible instead of hiding it — see lib/registry-lookups.ts.
  registrationVerificationMethod String?
  sanctionsCheckedAt      DateTime? // admin confirmed the org/contact isn't on a sanctions list (e.g. OFAC's SDN list)
  payoutNameCheckedAt     DateTime? // admin confirmed payoutAccountHolderName actually matches the org's name

  // Having a linked User is what lets an org register and manage itself
  // (name/mission/payout details) through the same unified login as
  // everyone else, instead of requiring an admin to create every cause by
  // hand — see /cause/onboarding. Nullable: admin-created causes have no
  // linked User until they (or an admin) connect one.
  user   User?   @relation(fields: [userId], references: [id])
  userId String? @unique

  // Same pluggable payout system as Artist (see lib/payout-channels/) —
  // a cause is just a second kind of payout recipient, not a different
  // system. MANUAL (the default) keeps today's behavior: an admin settles
  // it by hand via /admin/payouts.
  payoutChannel            PayoutChannel @default(MANUAL)
  payoutCountry            String?
  payoutCurrency           String?
  payoutMobileNetwork      String?
  payoutAccountNumber      String?
  payoutBankCode           String?
  stripeConnectedAccountId String?
  stripeConnectOnboarded   Boolean       @default(false)
  cryptoNetwork            String?
  cryptoAddress            String?
}

// A co-op supplies and vouches for multiple artists, and is the local
// consolidation/shipping point for that region's originals.
model CoOp {
  id            String   @id @default(cuid())
  name          String
  region        String
  contactEmail  String
  payoutAccount String?
  artists       Artist[]
  createdAt     DateTime @default(now())
}

model Animal {
  id             String      @id @default(cuid())
  slug           String      @unique
  name           String
  species        String
  region         String
  story          String
  imageUrl       String
  conservancy    Conservancy @relation(fields: [conservancyId], references: [id])
  conservancyId  String
  campaigns      Campaign[]
  createdAt      DateTime    @default(now())
}

model Artist {
  id            String      @id @default(cuid())
  slug          String      @unique
  name          String
  country       String
  bio           String
  imageUrl      String
  payoutAccount String?
  // Which automated rail (if any) actually moves this artist's payout —
  // see lib/payout-channels/. This is per-artist, not a single global
  // choice, because artists bank in different countries through different
  // systems: FLUTTERWAVE alone covers 30+ countries across mobile money
  // (M-Pesa in Kenya or Ethiopia, MTN/Airtel elsewhere) and bank transfer
  // (e.g. South Africa) — see the payoutCountry/payoutCurrency/
  // payoutMobileNetwork fields below, which is which. STRIPE_CONNECT is
  // for an artist banking in a Stripe-supported country instead. MANUAL
  // (the default) means no automated rail is set up — the payout still
  // releases as a tracked obligation (Payout.paidOutAt), an admin just
  // settles it by hand. Adding a new country/provider later is a new enum
  // value plus a new module in lib/payout-channels/, not a rewrite.
  payoutChannel PayoutChannel @default(MANUAL)
  // FLUTTERWAVE details — all generic, no country hardcoded anywhere in
  // code that reads these. payoutMobileNetwork set (e.g. "Mpesa", "MTN",
  // "Airtel") means mobile money and payoutAccountNumber is a phone
  // number; left null means bank transfer instead, and
  // payoutAccountNumber is a bank account number with payoutBankCode
  // required alongside it (e.g. Flutterwave's numeric bank codes in
  // Nigeria, or the short bank codes South African banks use).
  payoutCountry        String?
  payoutCurrency       String?
  payoutMobileNetwork  String?
  payoutAccountNumber  String?
  payoutBankCode       String?
  // STRIPE_CONNECT detail: set once the artist completes Stripe's hosted
  // onboarding (see /api/seller/connect/onboard). onboarded tracks
  // charges_enabled/payouts_enabled so we don't attempt a transfer to an
  // account that can't yet receive one.
  stripeConnectedAccountId String?
  stripeConnectOnboarded   Boolean @default(false)
  // CRYPTO detail: e.g. cryptoNetwork "USDC on Base", cryptoAddress the
  // wallet to send to. No automated sending — see the enum comment.
  cryptoNetwork String?
  cryptoAddress String?
  coOp          CoOp?       @relation(fields: [coOpId], references: [id])
  coOpId        String?
  socialLinks   SocialLink[]
  campaigns     Campaign[]
  createdAt     DateTime    @default(now())

  // Having a linked User is what makes this artist a "seller" — one login
  // (User) unlocks whichever surfaces they're entitled to. Nullable: an
  // artist added by an admin with no login has no linked User until they
  // (or an admin) connect one.
  user          User?       @relation(fields: [userId], references: [id])
  userId        String?     @unique
}

model SocialLink {
  id       String @id @default(cuid())
  platform String
  url      String
  artist   Artist @relation(fields: [artistId], references: [id])
  artistId String
}

// The core unit: one animal x one artist x one split ratio. Everything sold
// under this campaign inherits its split.
// A campaign always benefits exactly one cause — either indirectly through
// a specific Animal (the wildlife-portrait case this app started as: the
// cause is derived as animal.conservancy) or directly through
// conservancyId (any other campaign: the artist picks a registered cause,
// no animal involved at all). Exactly one of animalId/conservancyId is
// ever set — enforced in the campaign-creation routes, not the DB, since
// Postgres has no clean "exactly one of two nullable FKs" constraint.
// getCampaignConservancyId() in lib/payouts.ts is the one place that
// resolves which one applies — every payout-creating code path calls it
// rather than re-deriving this itself.
model Campaign {
  id                  String      @id @default(cuid())
  slug                String      @unique
  animal              Animal?     @relation(fields: [animalId], references: [id])
  animalId            String?
  conservancy         Conservancy? @relation(fields: [conservancyId], references: [id])
  conservancyId       String?
  artist              Artist      @relation(fields: [artistId], references: [id])
  artistId            String
  artistPercent       Int
  conservancyPercent  Int
  operationsPercent   Int
  status              CampaignStatus @default(DRAFT)
  artworks            Artwork[]
  createdAt           DateTime    @default(now())
}

enum CampaignStatus {
  DRAFT
  LIVE
  PAUSED
  ARCHIVED
}

model Artwork {
  id             String       @id @default(cuid())
  campaign       Campaign     @relation(fields: [campaignId], references: [id])
  campaignId     String
  title          String
  kind           ArtworkKind
  priceCents     Int
  currency       String       @default("usd")
  imageUrl       String
  altText        String
  // The curatorial write-up shown on the detail view (ArtworkLightbox) —
  // distinct from Artist.bio, which is about the person, not this specific
  // piece. Optional: existing rows predate this field, and a quick print
  // reissue may not need one.
  story          String?
  inventoryState InventoryState @default(AVAILABLE)
  reservedAt     DateTime?
  orders         Order[]
  inquiries      Inquiry[]
  createdAt      DateTime     @default(now())
}

enum ArtworkKind {
  ORIGINAL
  PRINT
}

// Originals are high-value and one-of-one, so they don't go through instant
// self-checkout — a visitor expresses interest here, the team follows up
// personally (payment method, shipping/insurance, timeline), and the
// resulting sale gets recorded through the existing admin cash-sale flow
// once terms are agreed. Prints stay on instant Stripe checkout.
model Inquiry {
  id        String        @id @default(cuid())
  artwork   Artwork       @relation(fields: [artworkId], references: [id])
  artworkId String
  name      String
  email     String
  message   String?
  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now())
}

enum InquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

// Originals are one-of-one; prints are fulfilled per order via a
// print-on-demand partner and stay AVAILABLE indefinitely.
enum InventoryState {
  AVAILABLE
  RESERVED
  SOLD
}

model Order {
  id                    String      @id @default(cuid())
  artwork               Artwork     @relation(fields: [artworkId], references: [id])
  artworkId             String
  customer              User?       @relation(fields: [customerId], references: [id])
  customerId            String?
  buyerEmail            String
  shippingName          String
  shippingAddressLine1  String
  shippingAddressLine2  String?
  shippingCity          String
  shippingRegion        String
  shippingPostalCode    String
  shippingCountry       String
  amountCents           Int
  currency              String      @default("usd")
  stripePaymentIntentId String?     @unique
  paymentMethod         PaymentMethod @default(STRIPE)
  status                OrderStatus @default(PENDING)
  // A Stripe chargeback in progress — orthogonal to `status` (fulfillment
  // progress) rather than a replacement for it, since a dispute can open on
  // an order that's already SHIPPED or DELIVERED and we must not lose that
  // fulfillment history. Set on charge.dispute.created, cleared on
  // charge.dispute.closed; see handleDispute in the Stripe webhook.
  disputedAt            DateTime?
  payouts               Payout[]
  shipment              Shipment?
  createdAt             DateTime    @default(now())
}

enum OrderStatus {
  // Declared but never actually produced: an Order row is only ever
  // created once payment is already confirmed — handleCheckoutCompleted
  // in the Stripe webhook and the cash-sale route both create rows
  // directly at PAID (or DELIVERED, for an in-person handoff), never at
  // checkout-session-creation time. Nothing currently sets this. Left in
  // the enum as an honest placeholder for "checkout started but not yet
  // confirmed" rather than silently dropped — wiring it up for real would
  // mean creating an Order when a Stripe Checkout session starts instead
  // of when it completes, which is real payment-pipeline work.
  PENDING
  PAID       // payment confirmed (Stripe webhook, or an admin recording cash), payouts not yet released
  SHIPPED    // buyer doesn't have it yet — payout release still waits for DELIVERED
  DELIVERED  // triggers payout release
  REFUNDED
}

// CASH covers any sale collected outside Stripe — cash in hand, bank
// transfer, at a market/fair — recorded by an admin instead of arriving via
// webhook. Everything downstream (split computation, hold-until-shipped
// payout release) is identical for both.
enum PaymentMethod {
  STRIPE
  CASH
}

// Payouts are held (PENDING) until the buyer actually has the piece in hand
// — order status DELIVERED (confirmed after shipping) or an in-person cash
// handoff — then released as Stripe Transfers to the recipient's
// connected/bank account. Holding through SHIPPED-but-not-yet-DELIVERED is
// deliberate: it's the window a refund (lost in transit, damaged,
// dissatisfaction) can still claw back a PENDING payout with nothing to
// unwind on the recipient's side. This is the audit trail for the public
// impact numbers.
model Payout {
  id            String        @id @default(cuid())
  order         Order         @relation(fields: [orderId], references: [id])
  orderId       String
  recipientType RecipientType
  recipientId   String // Artist.id, Conservancy.id, or "operations"
  amountCents   Int
  status        PayoutStatus  @default(PENDING)
  stripeTransferId String?
  releasedAt    DateTime?
  // RELEASED means "cleared to pay" (the buyer has the piece) — it does NOT
  // by itself mean money has moved. For an ARTIST payout where the artist
  // has set mpesaPhone and Flutterwave is configured, release attempts a
  // real M-Pesa transfer automatically (see lib/flutterwave.ts) and these
  // two fields track it. Everything else (conservancy, operations, or an
  // artist with no mpesaPhone yet) has no automated rail: it's an
  // obligation the admin settles manually — sweep this amount into a
  // separate holding account, then mark it paid out from there.
  // paidOutAt records that real-world step either way, independent of
  // `status` — see /admin/payouts.
  flutterwaveTransferId     String?
  flutterwaveTransferStatus String?
  paidOutAt     DateTime?
  createdAt     DateTime      @default(now())
}

enum RecipientType {
  ARTIST
  CONSERVANCY
  OPERATIONS
}

// One value per automated payout rail — see lib/payout-channels/. Add a
// value here plus a matching module to support a new country/provider;
// nothing else in the dispatch needs to change.
enum PayoutChannel {
  MANUAL
  FLUTTERWAVE
  STRIPE_CONNECT
  // No automated on-chain sending yet — deliberately. That needs the
  // business to hold real crypto funds and a private key in production,
  // which is its own security-sensitive project (proper custody, not an
  // env var), not something to bolt on here. For now this behaves like
  // MANUAL: the artist's wallet address/network show up in /admin/payouts
  // so an admin can send it from whatever wallet/exchange they actually
  // use, then mark it paid out.
  CRYPTO
}

enum PayoutStatus {
  PENDING
  RELEASED
  FAILED
}

model Shipment {
  id             String    @id @default(cuid())
  order          Order     @relation(fields: [orderId], references: [id])
  orderId        String    @unique
  carrier        String
  trackingNumber String?
  method         ShipmentMethod
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())
}

// ORIGINAL_FOUNDER: bootstrap phase, shipped from founder-held inventory.
// ORIGINAL_FREIGHT: scaled phase, co-op consolidates + fine-art freight forwarder.
// PRINT_POD: print-on-demand partner fulfills regionally, no international leg.
enum ShipmentMethod {
  ORIGINAL_FOUNDER
  ORIGINAL_FREIGHT
  PRINT_POD
}

// Uploaded images/documents stored directly in Postgres (bytea) rather
// than object storage — a deliberate choice, not the default recommendation
// (serving files out of the relational DB instead of a CDN-backed object
// store is slower for visitors and inflates Neon's storage-based billing
// for exactly the content — artwork images — that gets browsed most). See
// app/api/uploads/route.ts. Served back out via GET /api/uploads/[id].
model UploadedFile {
  id          String   @id @default(cuid())
  data        Bytes
  contentType String
  createdAt   DateTime @default(now())
}

// Singleton row (id is always "singleton") holding API keys the admin enters
// through /admin/settings instead of editing .env by hand. Values here take
// priority over env vars; env vars remain the fallback for first boot.
model Settings {
  id                  String   @id @default("singleton")
  stripeSecretKey     String?
  stripeWebhookSecret String?
  // Sends money to Kenyan artists' M-Pesa numbers directly — Flutterwave
  // holds US money-transmitter licenses, unlike Stripe (Kenya isn't a
  // supported Stripe country at all). See lib/flutterwave.ts.
  flutterwaveSecretKey     String?
  flutterwaveWebhookSecret String?
  resendApiKey        String?
  // SMTP is the fallback channel — sendEmail (lib/email.ts) tries Resend
  // first when configured, and only falls back to SMTP if Resend isn't
  // configured or a send through it fails. Not both-always: a customer
  // getting the same order confirmation twice is worse than one channel
  // occasionally covering for the other.
  smtpHost            String?
  smtpPort            String?
  smtpUser            String?
  smtpPassword        String?
  emailFrom           String?
  operationsEmail     String?

  // Branding — controlled entirely from /admin/settings so the site's name,
  // hero image, mission copy, and contact details never require a code
  // change. Null means "use the built-in fallback" (see lib/settings.ts).
  siteName         String?
  heroTagline      String?
  heroImageUrl     String?
  heroAlt          String?
  missionStatement String?
  contactName      String?
  contactEmail     String?
  contactPhone     String?

  updatedAt DateTime @updatedAt
}

enum EmailProvider {
  RESEND
  SMTP
  NONE
}

enum EmailStatus {
  SENT
  FAILED
  SKIPPED
}

// One row per send attempt from lib/email.ts's sendEmail — the only way to
// actually answer "did this order confirmation/password reset/etc. go
// out," since sendEmail itself never throws (a broken provider must never
// break checkout, a webhook, or order fulfillment) and previously only
// logged to console, which nothing keeps past the process's own lifetime.
model EmailLog {
  id        String        @id @default(cuid())
  to        String
  subject   String
  provider  EmailProvider
  status    EmailStatus
  error     String?
  createdAt DateTime      @default(now())

  @@index([createdAt])
}

// One row per hit from lib/rate-limit.ts's isRateLimited. Was an in-memory
// Map — fine for one process, but server.cluster.js now runs this app as
// several worker processes that each have their own separate memory, so an
// in-memory counter no longer sees hits recorded by a request another
// worker handled (confirmed live: 15/15 signups succeeded against the
// clustered server, 3x the intended 5-per-5-minute limit, zero 429s).
// Backed by Postgres instead — every worker already shares the same
// database, and this app already avoids standing up new infrastructure
// (Redis) for things Postgres can do at this volume; see the identical
// reasoning on UploadedFile for image storage.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model NewsArticle {
  id        String          @id @default(cuid())
  slug      String          @unique
  title     String
  summary   String
  body      String
  imageUrl  String
  status    NewsStatus      @default(DRAFT)
  createdAt DateTime        @default(now())
}

enum NewsStatus {
  DRAFT
  LIVE
}

// One identity, one login, for everyone — a single email+password gets you
// in through the same page regardless of what you're here to do. What you
// can actually access is layered on top of this one row, not a separate
// account per role:
//   - isAdmin true            -> can use /admin
//   - a linked Artist exists  -> can use /seller (that Artist IS their shop)
//   - always                  -> can browse/buy, see /account order history
// Someone can be more than one of these at once on the same login.
model User {
  id                  String                @id @default(cuid())
  email               String                @unique
  passwordHash        String
  name                String?
  isAdmin             Boolean               @default(false)
  artist              Artist?
  conservancy         Conservancy?
  orders              Order[]
  passwordResetTokens PasswordResetToken[]
  createdAt           DateTime              @default(now())
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id])
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
}
